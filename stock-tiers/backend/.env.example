# Stock provider: "mock" (default, offline) or "finnhub" (real market data)
STOCK_PROVIDER=mock

# Required only when STOCK_PROVIDER=finnhub. Free tier works (uses /quote,
# /stock/profile2, /stock/metric — not the premium /stock/candle).
FINNHUB_API_KEY=

# Max symbols the Finnhub screener scans on a cold call (keeps the first screen
# under the free-tier ~60 calls/min limit; results are cached for SCREENER_CACHE_TTL).
SCREENER_CANDIDATE_LIMIT=30

# Required only for the live Claude tier engine. With no key + TIER_PROVIDER=auto,
# a deterministic mock tier engine runs (zero-secret prototype).
ANTHROPIC_API_KEY=

# Tier engine selection: auto (Claude when key set, else mock) | mock | claude
TIER_PROVIDER=auto

# Let Claude use web search to ground picks in current facts (true|false).
# Disable to cut latency/cost or if the account lacks the web-search tool.
TIER_WEB_SEARCH=true

# Claude model + effort for the tier engine
TIER_MODEL=claude-opus-4-8
TIER_EFFORT=high

# Comma-separated allowed CORS origins ("*" allows all). Bare hosts -> https://.
CORS_ORIGINS=*

# Cache TTLs (seconds)
QUOTE_CACHE_TTL=60
SCREENER_CACHE_TTL=900
TIER_CACHE_TTL=86400

# Fall back to mock market data if the real provider errors / is rate-limited
RESILIENT_FALLBACK=true
