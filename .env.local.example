# Base URL of the FastAPI backend that serves schedule + search endpoints.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Force the frontend to serve everything from the local mock layer (src/mocks)
# instead of calling the backend. Useful for running the UI with no backend/DB.
NEXT_PUBLIC_USE_MOCKS=false

# ---------------------------------------------------------------------------
# Optional integration keys (all features degrade gracefully without them).
#
# These are SECRETS — do NOT paste real values here or in chat, and do NOT
# commit them. For Claude Code web sessions, add each one in:
#   environment settings -> Variables   (encrypted; takes effect next session)
# and allow-list the matching host under:
#   environment settings -> Network access -> Custom
# This file only records the variable NAMES so the convention is discoverable.
# ---------------------------------------------------------------------------

# Fan Footage pillar — live short clips from Pexels (free, commercial use).
# Host to allow-list: api.pexels.com   |   Get a key: https://www.pexels.com/api/
# Without it, getTouristVideos() serves the labeled seed clips (no fabrication).
# PEXELS_API_KEY=

# Design image generation (scripts/generate-asset.mjs, OpenAI gpt-image-1).
# Host to allow-list: api.openai.com
# OPENAI_API_KEY=

# AI assistant / chatbot (Anthropic Messages API via native fetch — no SDK).
# Default model: claude-haiku-4-5 (see src/lib/assistant.ts).
# Host to allow-list: api.anthropic.com
# ANTHROPIC_API_KEY=

# Affiliate / commission tracking ids for booking + flight deep links
# (src/mocks/offers.ts). Optional — links work without them, they just earn no
# commission. Not secrets, but set per environment. Mirror the backend's
# BOOKING_AID / KAYAK_AFFILIATE_ID.
# NEXT_PUBLIC_BOOKING_AID=
# NEXT_PUBLIC_KAYAK_AFFILIATE_ID=
