# Optional PostgreSQL connection. When unset, the API serves the in-process
# 2026 seed data and stores trips in memory, so no database is required for
# local development or tests.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/worldcup

# Comma-separated allowed CORS origins (the Next.js dev server by default).
CORS_ORIGINS=http://localhost:3000

# --- Provider adapters (Phase 3) ------------------------------------------
# Each vertical: "mock" (default), "http" (bring-your-own service), and for
# flights also "duffel". Real providers are wrapped with a cache + automatic
# fallback to mock, so a missing key or upstream outage degrades gracefully.
FLIGHT_PROVIDER=mock
HOTEL_PROVIDER=mock
TRANSPORT_PROVIDER=mock

PROVIDER_TIMEOUT_SECONDS=6
PROVIDER_CACHE_TTL_SECONDS=120

# Generic HTTP providers: POST the search query and return normalized offers.
# FLIGHTS_API_URL=https://your-service.example
# FLIGHTS_API_KEY=...
# HOTELS_API_URL=https://your-service.example
# HOTELS_API_KEY=...
# TRANSPORT_API_URL=https://your-service.example
# TRANSPORT_API_KEY=...

# Branded flight adapter (set FLIGHT_PROVIDER=duffel to activate).
# DUFFEL_API_KEY=...
# DUFFEL_BASE_URL=https://api.duffel.com

# --- Payments / checkout (Phase 4) ----------------------------------------
# "none" = affiliate deep-link model (default, no charges). "stripe" enables a
# PaymentIntent flow when STRIPE_SECRET_KEY is set.
PAYMENT_GATEWAY=none
# STRIPE_SECRET_KEY=sk_test_...
