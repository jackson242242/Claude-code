# Optional PostgreSQL connection. When unset, the API serves the in-process
# 2026 seed data and stores trips in memory, so no database is required for
# local development or tests.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/worldcup

# Comma-separated allowed CORS origins (the Next.js dev server by default).
CORS_ORIGINS=http://localhost:3000

# --- Provider adapters (Phase 3) ------------------------------------------
# Each vertical: "mock" (default), "http" (bring-your-own service), and for
# flights also "duffel". Hotels additionally support "liteapi" and "duffel".
# Real providers are wrapped with a cache + automatic fallback to mock, so a
# missing key or upstream outage degrades gracefully.
FLIGHT_PROVIDER=mock
HOTEL_PROVIDER=mock
TRANSPORT_PROVIDER=mock

PROVIDER_TIMEOUT_SECONDS=6
PROVIDER_CACHE_TTL_SECONDS=120

# Generic HTTP providers: POST the search query and return normalized offers.
# FLIGHTS_API_URL=https://your-service.example
# FLIGHTS_API_KEY=...
# HOTELS_API_URL=https://your-service.example
# HOTELS_API_KEY=...
# TRANSPORT_API_URL=https://your-service.example
# TRANSPORT_API_KEY=...

# Duffel adapters — one key powers both flights and hotels (Duffel Stays).
# Set FLIGHT_PROVIDER=duffel and/or HOTEL_PROVIDER=duffel to activate.
# DUFFEL_API_KEY=...
# DUFFEL_BASE_URL=https://api.duffel.com

# LiteAPI hotel adapter — set HOTEL_PROVIDER=liteapi to activate.
# LITEAPI_API_KEY=...
# LITEAPI_BASE_URL=https://api.liteapi.travel/v3.0

# --- Live schedule feed (optional) ----------------------------------------
# Overlays real fixtures onto the seed schedule by match number (teams,
# kickoff, venue, group, completed status). Without it the API serves the
# generated placeholder draw. TTL-cached; default 6h.
# SCHEDULE_FEED_URL=https://fixturedownload.com/feed/json/fifa-world-cup-2026
# SCHEDULE_FEED_TTL_SECONDS=21600

# --- Payments / checkout (Phase 4) ----------------------------------------
# "none" = affiliate deep-link model (default, no charges). "stripe" enables a
# PaymentIntent flow when STRIPE_SECRET_KEY is set.
PAYMENT_GATEWAY=none
# STRIPE_SECRET_KEY=sk_test_...
